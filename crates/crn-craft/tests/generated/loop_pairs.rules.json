        {
          "type": "B"
        }
      ]
    },
    {
      "name": "pair_ab",
      "reactants": [
        {
          "type": "A",
          "label": "x"
        },
        {
          "type": "B",
          "label": "y"
        }
      ],
      "rate": "q",
      "products": [
        {
          "type": "A"
        },
        {
          "type": "A"
        }
