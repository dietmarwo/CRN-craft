{
  "schema": "crn-craft.rules-model/0.1",
  "name": "loop_three_class_expression",
  "description": "The three-class model with degradation rates that read observables and the takeover stop.",
  "parameters": {
    "K": 1000,
    "delta": 0.0028881132523331052,
    "sw": 1.0,
    "sm": 1.5,
    "mu": 3e-05,
    "fracAdv": 0.2,
    "w0": 1000
  },
  "types": [
    {
      "name": "mtDNA",
      "attributes": [
        "clone",
        "s",
        "wt"
      ]
    }
  ],
  "initial": [
    {
      "type": "mtDNA",
      "attributes": {
        "clone": 0,
        "s": "sw",
        "wt": 1
      },
      "count": "w0"
    }
  ],
  "observables": {
    "N": {
      "type": "mtDNA"
    },
    "wild_type": {
      "type": "mtDNA",
      "where": "x.wt == 1"
    },
    "mutants": {
      "type": "mtDNA",
      "where": "x.wt == 0"
    },
    "advantaged_mutants": {
      "type": "mtDNA",
      "where": "x.clone == 2"
    },
    "D": {
      "type": "mtDNA",
      "weight": "x.wt + sm * (1 - x.wt)"
    },
    "neutral_mutants": {
      "type": "mtDNA",
      "where": "x.clone == 1"
    }
  },
  "rules": [
    {
      "name": "degradation_wt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "delta * (1 + mutants / K)",
      "products": []
    },
    {
      "name": "replication_wt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "if(N < K, (K - N) / D, 0) * (sw * (1 - mu))",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    },
    {
      "name": "mutation_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "max(0, K - N) / D * sw * mu * (1 - fracAdv)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "attributes": {
            "clone": 1,
            "s": "sw",
            "wt": 0
          }
        }
      ]
    },
    {
      "name": "mutation_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "max(0, K - N) / D * sw * mu * fracAdv",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "attributes": {
            "clone": 2,
            "s": "sm",
            "wt": 0
          }
        }
      ]
    },
    {
      "name": "degradation_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 1"
        }
      ],
      "rate": "delta * (1 + mutants / K)",
      "products": []
    },
    {
      "name": "replication_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 1"
        }
      ],
      "rate": "max(0, K - N) / D * (sw)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    },
    {
      "name": "degradation_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 2"
        }
      ],
      "rate": "delta * (1 + mutants / K)",
      "products": []
    },
    {
      "name": "replication_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 2"
        }
      ],
      "rate": "max(0, K - N) / D * (sm)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    }
  ],
  "stop": "N > 0 && mutants >= 0.9 * N"
}
