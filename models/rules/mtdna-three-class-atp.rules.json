{
  "schema": "crn-craft.rules-model/0.2",
  "name": "mtdna_three_class_atp",
  "description": "Three fixed mtDNA classes with the linear ATP balance and ATP-inhibited replication.",
  "parameters": {
    "K": 1000,
    "delta": 0.0028881132523331052,
    "sw": 1.0,
    "sm": 1.5,
    "mu": 3e-05,
    "fracAdv": 0.2,
    "w0": 1000
  },
  "types": [
    {
      "name": "mtDNA",
      "attributes": [
        "clone",
        "s",
        "wt"
      ]
    }
  ],
  "initial": [
    {
      "type": "mtDNA",
      "attributes": {
        "clone": 0,
        "s": "sw",
        "wt": 1
      },
      "count": "w0"
    }
  ],
  "observables": {
    "N": {
      "type": "mtDNA"
    },
    "wild_type": {
      "type": "mtDNA",
      "where": "x.wt == 1"
    },
    "mutants": {
      "type": "mtDNA",
      "where": "x.wt == 0"
    },
    "advantaged_mutants": {
      "type": "mtDNA",
      "where": "x.wt == 0 && x.s == sm"
    }
  },
  "rules": [
    {
      "name": "degradation_wt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "delta",
      "products": []
    },
    {
      "name": "replication_wt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "(sw * (1 - mu))",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    },
    {
      "name": "mutation_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "sw * mu * (1 - fracAdv)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "attributes": {
            "clone": 1,
            "s": "sw",
            "wt": 0
          }
        }
      ]
    },
    {
      "name": "mutation_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 0"
        }
      ],
      "rate": "sw * mu * fracAdv",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "attributes": {
            "clone": 2,
            "s": "sm",
            "wt": 0
          }
        }
      ]
    },
    {
      "name": "degradation_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 1"
        }
      ],
      "rate": "delta",
      "products": []
    },
    {
      "name": "replication_mt",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 1"
        }
      ],
      "rate": "(sw)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    },
    {
      "name": "degradation_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 2"
        }
      ],
      "rate": "delta",
      "products": []
    },
    {
      "name": "replication_mtAdv",
      "reactants": [
        {
          "label": "x",
          "type": "mtDNA",
          "where": "x.clone == 2"
        }
      ],
      "rate": "(sm)",
      "products": [
        {
          "type": "mtDNA",
          "copy": "x"
        },
        {
          "type": "mtDNA",
          "copy": "x"
        }
      ]
    }
  ],
  "atp": {
    "wild_type": "wild_type",
    "total": "N",
    "initial": 450.0,
    "production": 0.1,
    "decay": 0.2,
    "maintenance": 0.01,
    "scale": 1.3034153747670567,
    "replication_rules": [
      "replication_wt",
      "mutation_mt",
      "mutation_mtAdv",
      "replication_mt",
      "replication_mtAdv"
    ]
  }
}
