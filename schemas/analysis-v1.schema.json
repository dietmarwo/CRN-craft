{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AnalysisVersion": {
      "enum": [
        "crn-craft.analysis/0.1"
      ],
      "type": "string"
    },
    "ConservationLaw": {
      "additionalProperties": false,
      "properties": {
        "coefficients": {
          "description": "Primitive integer coefficients, encoded as strings to preserve i128 values.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "initial_total": {
          "type": "string"
        }
      },
      "required": [
        "coefficients",
        "initial_total"
      ],
      "type": "object"
    },
    "ConservationReport": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "items": {
            "$ref": "#/definitions/ConservationLaw"
          },
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/definitions/Diagnostic"
          },
          "type": "array"
        },
        "initial_class_upper_bounds": {
          "description": "Proven using non-negative basis rows only; None is not an unboundedness proof.",
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": "array"
        },
        "rank": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ConservationStatus"
        }
      },
      "required": [
        "basis",
        "diagnostics",
        "initial_class_upper_bounds",
        "status"
      ],
      "type": "object"
    },
    "ConservationStatus": {
      "enum": [
        "exact",
        "size_limit",
        "arithmetic_overflow"
      ],
      "type": "string"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "RFC 6901 JSON Pointer. Empty string denotes the document root.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      },
      "required": [
        "code",
        "hint",
        "message",
        "path",
        "severity"
      ],
      "type": "object"
    },
    "NetworkAnalysis": {
      "additionalProperties": false,
      "properties": {
        "conservation": {
          "$ref": "#/definitions/ConservationReport"
        },
        "dependencies": {
          "description": "Sorted propensity invalidations for each fired reaction index.",
          "items": {
            "items": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "evaluation_counts": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "initial_counts": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "propensities": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "reactions": {
          "items": {
            "$ref": "#/definitions/ReactionStructure"
          },
          "type": "array"
        },
        "species": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "conservation",
        "dependencies",
        "evaluation_counts",
        "initial_counts",
        "propensities",
        "reactions",
        "species"
      ],
      "type": "object"
    },
    "ReactionStructure": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "net_changes": {
          "description": "One stoichiometric matrix column: products minus reactants, zeros omitted.",
          "items": {
            "$ref": "#/definitions/Term"
          },
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/definitions/Term"
          },
          "type": "array"
        },
        "reactants": {
          "items": {
            "$ref": "#/definitions/Term"
          },
          "type": "array"
        },
        "reads": {
          "description": "Conservative reads, including reactant gates and custom-rate regulators.",
          "items": {
            "format": "uint",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "net_changes",
        "products",
        "reactants",
        "reads"
      ],
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    },
    "Term": {
      "additionalProperties": false,
      "description": "Sparse entry. Indices refer to the model's species declaration order.",
      "properties": {
        "coefficient": {
          "format": "int64",
          "type": "integer"
        },
        "species": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "coefficient",
        "species"
      ],
      "type": "object"
    }
  },
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/definitions/NetworkAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "items": {
        "$ref": "#/definitions/Diagnostic"
      },
      "type": "array"
    },
    "model_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "$ref": "#/definitions/AnalysisVersion"
    },
    "simulation_available": {
      "type": "boolean"
    },
    "state_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "diagnostics",
    "schema",
    "simulation_available",
    "success"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
