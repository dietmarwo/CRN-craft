{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Assessment": {
      "enum": [
        "exact_ensemble",
        "incomplete",
        "failed_checks"
      ],
      "type": "string"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "RFC 6901 JSON Pointer. Empty string denotes the document root.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      },
      "required": [
        "code",
        "hint",
        "message",
        "path",
        "severity"
      ],
      "type": "object"
    },
    "Replicate": {
      "additionalProperties": false,
      "properties": {
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/definitions/Diagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "saved_points": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "started": {
          "type": "boolean"
        },
        "stop_time": {
          "format": "double",
          "type": "number"
        },
        "termination": {
          "$ref": "#/definitions/Stop"
        }
      },
      "required": [
        "events",
        "id",
        "saved_points",
        "started",
        "stop_time",
        "termination"
      ],
      "type": "object"
    },
    "ResultVersion": {
      "enum": [
        "crn-craft.result/0.2"
      ],
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    },
    "Statistics": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "mean_standard_error": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sample_variance": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "samples": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "samples"
      ],
      "type": "object"
    },
    "Stop": {
      "enum": [
        "completed",
        "event_limit",
        "population_limit",
        "wall_time_limit",
        "cancelled",
        "failed",
        "output_limit"
      ],
      "type": "string"
    },
    "Trajectory": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "items": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "id": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "counts",
        "id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "assessment": {
      "$ref": "#/definitions/Assessment"
    },
    "completed_replicates": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/definitions/Diagnostic"
      },
      "type": "array"
    },
    "events": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "model_sha256": {
      "type": "string"
    },
    "replicates": {
      "items": {
        "$ref": "#/definitions/Replicate"
      },
      "type": "array"
    },
    "requested_replicates": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "root_seed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "run_sha256": {
      "type": "string"
    },
    "sampler": {
      "type": "string"
    },
    "save_times": {
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "#/definitions/ResultVersion"
    },
    "species": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "statistics": {
      "anyOf": [
        {
          "$ref": "#/definitions/Statistics"
        },
        {
          "type": "null"
        }
      ]
    },
    "termination": {
      "$ref": "#/definitions/Stop"
    },
    "trajectories": {
      "items": {
        "$ref": "#/definitions/Trajectory"
      },
      "type": "array"
    }
  },
  "required": [
    "assessment",
    "completed_replicates",
    "diagnostics",
    "events",
    "model_sha256",
    "replicates",
    "requested_replicates",
    "root_seed",
    "run_sha256",
    "sampler",
    "save_times",
    "schema",
    "species",
    "termination",
    "trajectories"
  ],
  "title": "SimulationResult",
  "type": "object"
}
