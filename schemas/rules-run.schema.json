{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_events_per_replicate": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_instances": {
          "description": "Distinct instances alive at once, over all types.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_output_bytes": {
          "format": "uint64",
          "minimum": 1.0,
          "type": "integer"
        },
        "max_sampling_steps_per_replicate": {
          "description": "Every random word, including rejected pair draws and product draws.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "threads": {
          "format": "uint32",
          "maximum": 64.0,
          "minimum": 1.0,
          "type": "integer"
        },
        "wall_time_s": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "max_events_per_replicate",
        "max_instances",
        "max_output_bytes",
        "max_sampling_steps_per_replicate",
        "threads"
      ],
      "type": "object"
    },
    "Ensemble": {
      "additionalProperties": false,
      "properties": {
        "replicates": {
          "format": "uint64",
          "minimum": 1.0,
          "type": "integer"
        },
        "root_seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "replicates",
        "root_seed"
      ],
      "type": "object"
    },
    "LogSpec": {
      "additionalProperties": false,
      "properties": {
        "max_entries": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "rules": {
          "default": [],
          "description": "An empty list logs all rules. Leaps match any listed firing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "max_entries"
      ],
      "type": "object"
    },
    "Method": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "tree"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "static_direct"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "mtdna_direct"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "next_reaction"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "thinning"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "epsilon": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "enum": [
                "tau"
              ],
              "type": "string"
            }
          },
          "required": [
            "epsilon",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "binomial"
              ],
              "type": "string"
            },
            "step": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        }
      ]
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Portable, relative to the run file's directory; no parent traversal.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the exact model input bytes, lowercase hexadecimal.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "properties": {
        "keep_instances": {
          "description": "Final instances of replicates 0..keep_instances.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "keep_paths": {
          "description": "Observable series of replicates 0..keep_paths.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "statistics": {
          "items": {
            "$ref": "#/definitions/Statistic"
          },
          "type": "array"
        }
      },
      "required": [
        "keep_instances",
        "keep_paths",
        "statistics"
      ],
      "type": "object"
    },
    "RunVersion": {
      "enum": [
        "crn-craft.rules-run/0.1",
        "crn-craft.rules-run/0.2",
        "crn-craft.rules-run/0.3"
      ],
      "type": "string"
    },
    "Statistic": {
      "enum": [
        "mean",
        "variance"
      ],
      "type": "string"
    },
    "Time": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "description": "Simulated time horizon, positive and finite.",
          "format": "double",
          "type": "number"
        },
        "report_times": {
          "description": "Strictly increasing times in [0, end] at which observables are reported (right-continuous: events at a report time are included).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "end",
        "report_times"
      ],
      "type": "object"
    },
    "TrackerSpec": {
      "additionalProperties": false,
      "properties": {
        "first_passage": {
          "type": [
            "string",
            "null"
          ]
        },
        "keep_episodes": {
          "default": 0,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "observable": {
          "type": "string"
        }
      },
      "required": [
        "observable"
      ],
      "type": "object"
    }
  },
  "properties": {
    "budget": {
      "$ref": "#/definitions/Budget"
    },
    "ensemble": {
      "$ref": "#/definitions/Ensemble"
    },
    "event_log": {
      "allOf": [
        {
          "$ref": "#/definitions/LogSpec"
        }
      ],
      "description": "rules-run/0.2 and later. `null` is rejected."
    },
    "method": {
      "allOf": [
        {
          "$ref": "#/definitions/Method"
        }
      ],
      "description": "rules-run/0.2 and later; absent selects `tree`. `null` is rejected."
    },
    "model": {
      "$ref": "#/definitions/ModelRef"
    },
    "outputs": {
      "$ref": "#/definitions/Outputs"
    },
    "schema": {
      "$ref": "#/definitions/RunVersion"
    },
    "time": {
      "$ref": "#/definitions/Time"
    },
    "trackers": {
      "description": "rules-run/0.2 and later. Not allowed in 0.1, even when empty.",
      "items": {
        "$ref": "#/definitions/TrackerSpec"
      },
      "type": "array"
    }
  },
  "required": [
    "budget",
    "ensemble",
    "model",
    "outputs",
    "schema",
    "time"
  ],
  "title": "RunRequest",
  "type": "object"
}
