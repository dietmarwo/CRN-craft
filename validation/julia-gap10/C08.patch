+/// Exact learned order, with rates stored contiguously in that same order.
+#[derive(Default)]
+pub(super) struct Sorting {
+    order: Vec<usize>,
+    rates: Vec<f64>,
+    positions: Vec<usize>,
+}
+impl Sorting {
+    pub(super) fn reset(&mut self, n: usize) {
+        self.order.clear();
+        self.order.extend(0..n);
+        self.positions.clear();
+        self.positions.extend(0..n);
+        self.rates.resize(n, 0.0);
+        self.rates.fill(0.0);
+    }
+    pub(super) fn update(&mut self, rx: usize, a: f64) {
+        self.rates[self.positions[rx]] = a;
+    }
+    pub(super) fn sample(
+        &mut self,
+        total: f64,
+        rng: &mut impl RngCore,
+        draws: &mut Draws,
+    ) -> Result<usize, Bail> {
+        loop {
+            let threshold = draws.closed(rng)? * total;
+            if threshold >= total {
+                return Err(numeric("sorting threshold rounded to total").into());
+            }
+            let mut sum = 0.0;
+            for (position, &rate) in self.rates.iter().enumerate() {
+                if position % 64 == 63 {
+                    draws.poll()?;
+                }
+                let next = sum + rate;
+                if rate > 0.0 && next <= sum {
+                    return Err(numeric("sorting sum loses a positive channel").into());
+                }
+                sum = next;
+                if threshold < sum {
+                    let channel = self.order[position];
+                    if position > 0 {
+                        self.order.swap(position, position - 1);
+                        self.rates.swap(position, position - 1);
+                        self.positions[self.order[position]] = position;
+                        self.positions[channel] = position - 1;
+                    }
+                    return Ok(channel);
+                }
+            }
+            if sum == 0.0 {
+                return Err(numeric("sorting selection has no positive channel").into());
+            }
+            draws.poll()?;
+        }
+    }
+}
