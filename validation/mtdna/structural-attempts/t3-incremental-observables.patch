+/// Below 2^23, every integer multiple of 2^-30 is exactly representable.
+const EXACT_LIMIT: f64 = 8_388_608.0;
+const EXACT_SCALE: f64 = 1_073_741_824.0;
+
+/// The change of a sum observable when `changes` are applied, if updating it
+/// incrementally gives the same bits as recomputing it: every weight is a
+/// finite, nonnegative integer multiple of 2^-30 (so, with the value below
+/// `EXACT_LIMIT`, every partial sum is exact) and the change is exact.
+/// Otherwise NaN, and the observable is recomputed.
+fn exact_delta(projection: &Projection, changes: &[(usize, i64)]) -> f64 {
+    let (_, reduce, terms) = projection;
+    if !matches!(reduce, Reduce::Sum) {
+        return f64::NAN;
+    }
+    let mut scaled: i128 = 0;
+    for &(s, w) in terms {
+        let units = w * EXACT_SCALE;
+        if !(w >= 0.0 && units.is_finite() && units.fract() == 0.0 && units < 9.0e15) {
+            return f64::NAN;
+        }
+        #[allow(clippy::cast_possible_truncation)]
+        let units = units as i128;
+        for &(x, d) in changes {
+            if x == s {
+                scaled += i128::from(d) * units;
+            }
+        }
+    }
+    if scaled.unsigned_abs() >= 1 << 53 {
+        return f64::NAN;
+    }
+    #[allow(clippy::cast_precision_loss)]
+    let delta = scaled as f64 / EXACT_SCALE;
+    delta
+}
